<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.harsh</groupId>
    <artifactId>cloudsim-cluster</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>Heterogeneous Resource Allocation</name>

    <description>
        CloudSim-based heterogeneous resource allocation foundation
        for event-aware agentic cloud management.
    </description>

    <properties>
        <!-- Java configuration -->
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <!-- Dependency versions -->
        <cloudsimplus.version>7.3.0</cloudsimplus.version>
        <junit.version>5.11.4</junit.version>
        <adk.version>1.6.0</adk.version>
        <gson.version>2.14.0</gson.version>
        <jsoup.version>1.23.2</jsoup.version>

        <!-- Maven plugin versions -->
        <maven.compiler.plugin.version>
            3.11.0
        </maven.compiler.plugin.version>

        <maven.surefire.plugin.version>
            3.5.2
        </maven.surefire.plugin.version>
    </properties>

    <dependencies>

        <!-- Cloud simulation framework -->
        <dependency>
            <groupId>org.cloudsimplus</groupId>
            <artifactId>cloudsimplus</artifactId>
            <version>${cloudsimplus.version}</version>
        </dependency>

        <!-- Google Agent Development Kit for Java -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk</artifactId>
            <version>${adk.version}</version>
        </dependency>

        <!-- Converts Gemini JSON output into Java objects -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Parses downloaded HTML into visible webpage evidence -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- Unit-testing framework -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Compiles the project using Java 24 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>
                    ${maven.compiler.plugin.version}
                </version>

                <configuration>
                    <release>24</release>
                </configuration>
            </plugin>

            <!-- Discovers and executes JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>
                    ${maven.surefire.plugin.version}
                </version>
            </plugin>

        </plugins>
    </build>

</project>